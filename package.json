{
  "name": "spawn",
  "productName": "spawn",
  "version": "1.3.41",
  "description": "Claude Code sessions with Pokémon partners: a Windows desktop app (personal, non-commercial)",
  "author": "DueStar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DueStar/spawn.git"
  },
  "homepage": "https://github.com/DueStar/spawn",
  "bugs": {
    "url": "https://github.com/DueStar/spawn/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"sleep 2 && electron .\"",
    "dev:all": "concurrently \"node server/index.js\" \"vite\"",
    "build": "tsc && vite build",
    "build:electron": "vite build && electron-builder",
    "pack": "vite build && electron-builder --dir",
    "electron": "electron .",
    "start": "npm run dev:electron",
    "server": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^8.2.2",
    "express": "^4.19.2",
    "node-pty": "^1.1.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "supertest": "^7.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "local.spawn.app",
    "productName": "spawn",
    "artifactName": "spawn-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "hooks/**",
      "!dist/sprites/pokemon/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "dir"
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true
  }
}
